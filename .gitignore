# محیط اجرا و وابستگی‌ها (با install.bat یا build_portable.py ساخته می‌شوند)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# مدل گفتار (~۱٫۶ گیگابایت؛ با download_model.bat دریافت می‌شود)
models/

# اطلاعات کاربر: ویس‌ها، رکوردها، پشتیبان‌ها و فایل‌های اکسل — هرگز در مخزن نیست
data/

# خروجی ساخت (بسته قابل‌حمل و به‌روزرسانی‌ها)
dist/
packaging/cache/

# فایل‌های اکسل و ویس واقعی که ممکن است برای آزمون کنار پروژه گذاشته شوند
*.xlsx
*.xlsm
!tests/**/*.xlsx
*.ogg
*.opus
*.m4a
*.wav
